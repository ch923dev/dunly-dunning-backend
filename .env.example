# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Database (PostgreSQL — used by both Prisma and pg-boss)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dunly?schema=public

# Auth (Better Auth)
BETTER_AUTH_SECRET=replace-with-32-char-random-string
BETTER_AUTH_URL=http://localhost:4000

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Connect platform OAuth (Dashboard -> Settings -> Connect -> Onboarding options -> OAuth)
STRIPE_CLIENT_ID=ca_xxx
CONNECT_REDIRECT_URL=http://localhost:4000/api/stripe/callback

# Resend
RESEND_API_KEY=re_xxx
EMAIL_FROM="Dunly <billing@yourdomain.com>"

# Stop-on-reply receiving domain (phase 5) — unset = feature inert
INBOUND_REPLY_DOMAIN=reply.example.com
